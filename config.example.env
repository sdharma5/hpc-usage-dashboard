# hpc-usage-dashboard settings.
# Copy this to config.env (setup.sh does this for you) and fill it in.
# No secrets go here — Cloudflare tokens and Slack tokens live outside the
# repo, in ~/.config/<APP_SLUG>/, so this file is safe to commit to git.

# ---- identity ---------------------------------------------------------------
LAB_NAME="My Lab"
# The name of your cluster (the machine), not the scheduler. Slurm is the scheduler software
# (sbatch/squeue/sacct) almost every cluster this tool works with runs; CLUSTER_NAME is whatever
# your site calls the actual machine, e.g. Skipjack, Frontera, Perlmutter.
CLUSTER_NAME=MyCluster
# Short id with no spaces: used for the Slurm job name, the page's
# ~/.config/<APP_SLUG>/ secrets folder, and file names. Lowercase, hyphens ok.
APP_SLUG=mylab-usage

# ---- Slurm --------------------------------------------------------------------
# The account (allocation) this page reports on.
ACCOUNT=myaccount
# Partition the daily refresh job itself runs on (it only needs 1 CPU, 1 GB, a
# few minutes — pick your cluster's lightest/cheapest partition).
PARTITION=general
# Local time the page rebuilds each day, 24h HH:MM.
REFRESH_HOUR=06:00
# Label shown next to that time, e.g. ET, PT, CET. Cosmetic only.
TIMEZONE_LABEL=ET
# The example job used in the "what a job costs now" table.
REF_CORES=8
REF_GB=64

# ---- look ---------------------------------------------------------------------
# Accent color (hex). Used for headings, the "left" fraction bar, table rules,
# and as color slot 1 of the per-person palette.
ACCENT=#2563eb
# Optional: a username who should always get color slot 1 (the accent color),
# e.g. whoever maintains the page. Leave blank to let slots assign normally.
PINNED_USER=

# ---- hosting (optional) --------------------------------------------------------
# Cloudflare Pages project name. Leave blank to skip online hosting — the page
# still gets rebuilt on the cluster, just not uploaded anywhere.
# The site will be at https://<CF_PROJECT>.pages.dev
CF_PROJECT=
# Only needed if you host somewhere other than Cloudflare Pages: the public
# URL to put in the Slack message and in the "does usage reset" text. Leave
# blank to use the Cloudflare Pages URL above automatically.
PUBLIC_URL=

# ---- Slack (optional) -----------------------------------------------------------
# true/false. See docs/SLACK_SETUP.md. Credentials go in
# ~/.config/<APP_SLUG>/slack.env, never here.
SLACK_ENABLED=false
