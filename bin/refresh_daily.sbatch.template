#!/bin/bash
#SBATCH --job-name=@@APP_SLUG@@-daily
#SBATCH --account=@@ACCOUNT@@
#SBATCH --partition=@@PARTITION@@
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --time=00:05:00
#SBATCH --output=@@ROOT@@/logs/%j.out
# Rebuild the usage page, then queue the next run for the next @@REFRESH_HOUR@@ (today's if
# that time hasn't passed yet today, otherwise tomorrow's).
# Cron and scrontab are disabled on many clusters, so this job re-submits itself.
# The next run is queued FIRST so a failed rebuild cannot break the chain, and only if no run
# is already waiting, so there is never more than one chain running.
# (Generated by setup.sh from bin/refresh_daily.sbatch.template. Re-run setup.sh to change the
# account, partition or time; don't hand-edit the #SBATCH lines above, they'll be overwritten.)
DIR="@@ROOT@@"
JOBNAME="@@APP_SLUG@@-daily"
if [ -z "$(squeue -u "$USER" -n "$JOBNAME" -t PD -h)" ]; then
  if [ "$(date +%H:%M)" \< "@@REFRESH_HOUR@@" ]; then NEXT=today; else NEXT=tomorrow; fi
  sbatch --begin="$(date -d "$NEXT @@REFRESH_HOUR@@" +%Y-%m-%dT%H:%M:%S)" "$DIR/refresh_daily.sbatch"
fi
@@PYTHON@@ "$DIR/bin/build_usage_page.py"
bash "$DIR/bin/deploy_cloudflare.sh" || echo "Cloudflare upload failed; the page on the cluster is still updated"
@@PYTHON@@ "$DIR/bin/post_slack.py" || echo "Slack post failed; the page is still updated"
